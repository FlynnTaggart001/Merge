# Copy to your local runtime environment. NEVER commit real secrets.
#
# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro

# xAI / Grok
XAI_API_KEY=
XAI_MODEL=grok-4.5

# Claude Code
# The runtime expects the `claude` CLI to be installed and authenticated locally.
CLAUDE_CODE_COMMAND=claude

# Orchestrator safety
MERGE_ORCHESTRATOR_MODE=supervised
MERGE_MAX_RETRIES=2
