# Merge AI integration template
# NEVER put real credentials in this file.
# Copy to .env locally and keep .env untracked.

# Selected toolchain: ChatGPT Plus, Claude Code, Wingman Premium.
# ChatGPT Plus is not OpenAI API access; do not add an OPENAI_API_KEY for the subscription.
# Claude Code authenticates through its local installation.
# Wingman is used inside Unreal Editor; no API key is configured here.

# Global safety limits (applied by Orchestrator at runtime)
AI_MAX_REQUESTS_PER_MINUTE=30
AI_MAX_REQUESTS_PER_HOUR=500
AI_MAX_RETRIES=2
AI_REQUEST_TIMEOUT_SECONDS=60
AI_MAX_CONCURRENT_REQUESTS=4

# Token budgets — hard ceilings enforced before any provider call
AI_MAX_INPUT_TOKENS_PER_REQUEST=12000
AI_MAX_OUTPUT_TOKENS_PER_REQUEST=4000
AI_MAX_TOTAL_TOKENS_PER_TASK=20000
AI_MAX_TOTAL_TOKENS_PER_SESSION=100000

# Cost guardrails
AI_MAX_COST_PER_CALL_USD=0.50
AI_MAX_COST_PER_TASK_USD=2.00
AI_MAX_COST_PER_SESSION_USD=10.00
AI_MAX_COST_PER_DAY_USD=5.00
AI_MAX_COST_PER_MONTH_USD=50.00

# Circuit breaker
AI_FAILURE_THRESHOLD=5
AI_COOLDOWN_SECONDS=300

# Retry / backoff
AI_INITIAL_BACKOFF_SECONDS=0.5
AI_MAX_BACKOFF_SECONDS=30
AI_BACKOFF_MULTIPLIER=2.0
AI_BACKOFF_JITTER=0.25

# Environment
MERGE_ENV=development
MERGE_ORCHESTRATOR_MODE=supervised
